# Security headers (internet.nl). Static page: its script, style and images are all files here,
# nothing inline, so 'self' covers everything.
Header always set X-Frame-Options "DENY"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
Header always set Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
# No HTTP compression (BREACH)
SetEnv no-gzip 1
